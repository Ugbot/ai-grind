# Python-generated files (anchored to repo root so they don't shadow source
# packages such as src/devtools_mcp/build/)
__pycache__/
*.py[oc]
/build/
/dist/
/wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches (mypy/pytest/ruff each write their own inner .gitignore too,
# but pin them here so ignoring survives a cache wipe)
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Compiled test fixtures (rebuild from source)
tests/fixtures/target
tests/fixtures/target.dSYM/

# Generated loadable skill mirror (rebuild with: python skills/sync.py)
skills/loadable/

# Generated client mirrors (rebuild with: python skills/sync.py --target agents|codex|cursor)
.agents/
.codex/
.cursor/rules/

# Profiler droppings
PerfViewData*

# Project-synced skill mirror + local settings (generated; source is skills/authored + skills/catalog)
.claude/skills/
.claude/commands/
.claude/agents/
.claude/settings.local.json

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

